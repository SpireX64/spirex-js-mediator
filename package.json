{
  "name": "@spirex/mediator",
  "version": "1.1.0",
  "description": "Lightweight mediator for JavaScript and TypeScript that simplifies event-driven architecture, CQRS, and decoupled application design.",
  "keywords": [
    "mediator",
    "cqrs",
    "command-query",
    "events",
    "event-bus",
    "event-driven",
    "event-listener",
    "message-bus",
    "message-driven",
    "command-handler",
    "pub-sub",
    "async",
    "ddd",
    "domain-driven-design",
    "decoupled-architecture",
    "orchestration",
    "decoupling",
    "javascript",
    "typescript",
    "lightweight",
    "spirex"
  ],
  "homepage": "https://github.com/SpireX64/spirex-js-mediator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpireX64/spirex-js-mediator.git",
    "directory": "packages/di"
  },
  "author": {
    "name": "Artem Sobolenkov",
    "email": "SpireX@outlook.com",
    "url": "https://github.com/SpireX64"
  },
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.mjs"
      },
      "require": {
        "default": "./dist/index.cjs"
      },
      "default": {
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run --config ./vitest.config.mjs",
    "test:c": "vitest run --config ./vitest.config.mjs --coverage",
    "build": "rollup --config --environment NODE_ENV:development",
    "build:release": "rollup --config --environment NODE_ENV:production",
    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@vitest/coverage-istanbul": "3.1.2",
    "eslint": "9.25.1",
    "prettier": "3.2.5",
    "rimraf": "6.0.1",
    "rollup": "4.17.2",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-terser": "7.0.2",
    "vitest": "3.1.2"
  }
}
